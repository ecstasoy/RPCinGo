    {
      "type": "text", "id": "tl_header", "x": 542, "y": 80, "width": 450, "height": 200,
      "text": "20-Byte Wire Header\n\nMagic[0:2]   =  0xCA 0xFE\nVersion[2]   =  0x01\nMsgType[3]   =  0x01  (Request)\nCodecType[4] =  0x01  (JSON)\nCompress[5]  =  0x00  (None)\nReserved[6:8] = 0x00 0x00\nRequestID[8:16] = 0x000000000000002A  (42)\nBodyLen[16:20]  = 0x0000007C  (124 bytes)",
      "originalText": "20-Byte Wire Header\n\nMagic[0:2]   =  0xCA 0xFE\nVersion[2]   =  0x01\nMsgType[3]   =  0x01  (Request)\nCodecType[4] =  0x01  (JSON)\nCompress[5]  =  0x00  (None)\nReserved[6:8] = 0x00 0x00\nRequestID[8:16] = 0x000000000000002A  (42)\nBodyLen[16:20]  = 0x0000007C  (124 bytes)",
      "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "middle",
